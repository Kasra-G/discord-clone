{
	"name": "frontend",
	"version": "0.0.1",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24.13.3",
		"@types/set-cookie-parser": "^2.4.10",
		"@vitest/browser-playwright": "^4.1.10",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"playwright": "^1.61.1",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0",
		"typescript-svelte-plugin": "^0.3.52",
		"vite": "^8.1.4",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^2.2.1"
	},
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"type": "module",
	"dependencies": {
		"@grpc/grpc-js": "^1.14.4",
		"@opentelemetry/auto-instrumentations-node": "^0.78.0",
		"@opentelemetry/exporter-logs-otlp-grpc": "^0.220.0",
		"@opentelemetry/exporter-metrics-otlp-grpc": "^0.220.0",
		"@opentelemetry/exporter-trace-otlp-grpc": "^0.220.0",
		"@opentelemetry/sdk-logs": "^0.220.0",
		"@opentelemetry/sdk-metrics": "^2.9.0",
		"@opentelemetry/sdk-node": "^0.220.0",
		"import-in-the-middle": "^3.3.1",
		"pino": "^10.3.1",
		"pino-opentelemetry-transport": "^3.0.0",
		"pino-pretty": "^13.1.3",
		"set-cookie-parser": "^3.1.2",
		"zod": "^4.4.3"
	},
	"trustedDependencies": [
		"protobufjs"
	]
